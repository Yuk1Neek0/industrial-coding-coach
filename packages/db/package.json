{
  "name": "@workspace/db",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./client": "./src/client.ts",
    "./github": "./src/github/index.ts",
    "./ccpm": "./src/ccpm/index.ts",
    "./stack": "./src/stack/index.ts",
    "./mapper": "./src/mapper/index.ts",
    "./observability": "./src/observability/index.ts",
    "./learning-units": "./src/learning-units/index.ts",
    "./learning-memories": "./src/learning-memories/index.ts"
  },
  "scripts": {
    "lint": "eslint",
    "format": "prettier --write \"**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx src/seed.ts"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/react": "^19.2.17",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.112.5",
    "@react-pdf/renderer": "^4.5.1",
    "@workspace/ai": "workspace:*",
    "better-sqlite3": "^12.10.0",
    "drizzle-orm": "^0.45.2",
    "fflate": "^0.8.3",
    "react": "^19.2.8",
    "yaml": "^2.9.0"
  }
}
