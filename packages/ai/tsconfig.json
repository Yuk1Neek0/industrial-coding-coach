{
  "extends": "@workspace/typescript-config/base.json",
  "compilerOptions": {
    // Bundler resolution: this package is consumed by bundlers (Next/Turbopack)
    // and Vitest — extensionless relative imports resolve everywhere.
    "module": "ESNext",
    "moduleResolution": "Bundler"
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
