# Environment variable template — committed.
# Copy to `.env` (git-ignored) and fill in real values locally.
# Never commit real secrets. Keys here must stay as empty placeholders.

# Golden Path Catalog database (local SQLite — see ADR 0006).
# Optional: overrides the default packages/db/catalog.db location.
# DB_FILE_NAME=

# GitHub repository import (see ADR 0009).
# Optional GitHub personal access token used to import repositories.
#  - Leave empty to import PUBLIC repos at the unauthenticated rate limit.
#  - Set a token to import PRIVATE repos and get the higher rate limit.
# Read-only scope only: a fine-grained token with read "Contents" + "Metadata",
# or a classic token with the `repo` scope. The product never writes to GitHub.
# NEVER commit a real token — this file holds an empty placeholder only.
# GITHUB_TOKEN=

# Add new variables below as features introduce them, e.g.:
# NEXT_PUBLIC_APP_NAME=
# ANTHROPIC_API_KEY=
